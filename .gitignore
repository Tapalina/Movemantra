# Dependencies – reinstalled with `npm install`
node_modules/

# Build output – the hosting platform builds this itself
dist/
dist-ssr/
*.local

# Environment files (secrets must never be committed)
.env
.env.*
!.env.example
.dev.vars

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caches
.cache/
.vite/
.eslintcache
*.tsbuildinfo

# Hosting CLIs
.vercel/
.netlify/
.wrangler/

# Editors and OS files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.sw?
.DS_Store
Thumbs.db
desktop.ini
